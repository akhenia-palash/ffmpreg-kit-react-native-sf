include $(CLEAR_VARS)
LOCAL_MODULE := libswresample
LOCAL_SRC_FILES := $(FFMPEG_PREBUILT_LIBS_PATH)/libswresample$(MY_LIB_SUFFIX).so
LOCAL_EXPORT_C_INCLUDES := $(FFMPEG_PREBUILT_INCLUDES_PATH)
include $(PREBUILT_SHARED_LIBRARY)

include $(CLEAR_VARS)
LOCAL_MODULE := libswscale
LOCAL_SRC_FILES := $(FFMPEG_PREBUILT_LIBS_PATH)/libswscale$(MY_LIB_SUFFIX).so
LOCAL_EXPORT_C_INCLUDES := $(FFMPEG_PREBUILT_INCLUDES_PATH)
include $(PREBUILT_SHARED_LIBRARY)

LOCAL_PATH := $(FFMPEG_PREBUILT_OLD_LOCAL_PATH)
